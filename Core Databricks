COPY INTO
What: SQL command that loads data from cloud storage into Delta table — tracks which files already loaded
COPY INTO bronze.orders
FROM 'abfss://container@storage/raw/orders/'
FILEFORMAT = JSON
COPY_OPTIONS ('mergeSchema' = 'true');
