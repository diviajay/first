APPLY CHANGES INTO — CDC in DLT
# Handle CDC data (inserts, updates, deletes)
# from source like Kafka or Delta CDC

dlt.create_streaming_table("silver_customers")

dlt.apply_changes(
    target = "silver_customers",
    source = "bronze_customers_cdc",
    keys = ["customer_id"],           # Match on this!
    sequence_by = "updated_timestamp", # Latest wins!
    apply_as_deletes = expr(
        "operation = 'DELETE'"
    ),
    except_column_list = ["operation",
                          "updated_timestamp"]
)

# Handles:
# INSERT → Add new record ✅
# UPDATE → Update existing record ✅
# DELETE → Remove record ✅
# All automatically! ✅
